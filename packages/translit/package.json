{
  "name": "@interslavic/translit",
  "version": "0.1.0",
  "type": "module",
  "description": "Transliteration between Interslavic Latin, Cyrillic, Glagolitic and IPA",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "interslavic-source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./phonology": {
      "types": "./dist/substitutions.d.ts",
      "interslavic-source": "./src/substitutions.ts",
      "default": "./dist/substitutions.js"
    },
    "./alphabet": {
      "types": "./dist/alphabet.d.ts",
      "interslavic-source": "./src/alphabet.ts",
      "default": "./dist/alphabet.js"
    },
    "./index.browser.min.js": "./dist/index.browser.min.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!**/__*__",
    "!**/*.test.*"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsc && rollup -c",
    "lint": "eslint src/**/*.ts && tsc -p tsconfig.lint.json",
    "test": "node --test 'src/**/*.test.ts'",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 --test-coverage-exclude='../../tools/**' 'src/**/*.test.ts'",
    "test:update": "UPDATE_SNAPSHOT=1 yarn test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/medzuslovjansky/js-utils.git"
  },
  "keywords": [
    "interslavic",
    "transliteration",
    "cyrillic",
    "glagolitic"
  ],
  "contributors": [
    "Jan van Steenbergen",
    "Sergey Cherebedov",
    "Denis Shabalin",
    "Rafail Gasparyan",
    "Yaroslav Serhieiev <noomorph@gmail.com>"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/medzuslovjansky/js-utils/issues"
  },
  "homepage": "https://github.com/medzuslovjansky/js-utils#readme",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@interslavic/dev-snapshot": "workspace:*",
    "@rollup/plugin-terser": "^1.0.0",
    "@types/node": "^26.2.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.9.6",
    "rollup": "^4.62.4",
    "typescript": "npm:@typescript/typescript6@~6.0.2",
    "typescript-eslint": "^8.67.0",
    "typescript-native": "npm:typescript@~7.0.2"
  },
  "browserslist": [
    "node 18",
    "iOS >= 14.5"
  ],
  "publishConfig": {
    "access": "public"
  }
}
