{
  "name": "@interslavic/monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "tools/*",
    "website"
  ],
  "scripts": {
    "build": "yarn workspaces foreach -A --topological-dev run build",
    "test": "yarn workspaces foreach -A --topological-dev run test",
    "test:coverage": "yarn workspaces foreach -A --topological-dev run test:coverage",
    "lint": "yarn workspaces foreach -A --topological-dev run lint",
    "release": "scripts/release.sh",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "cz-conventional-changelog": "^3.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "yarn@4.18.0"
}
